def test_classification():

    raw = make_fixture()

    normalized = (
        classify_and_normalize(
            raw
        )
    )

    jobs, steps = (
        split_jobs_and_steps(
            normalized
        )
    )

    assert jobs.height == 1
    assert steps.height == 3

    assert (
        steps.filter(
            pl.col(
                "step_type"
            ) == "application"
        ).height
        == 1
    )


def test_step_preparation():

    raw = make_fixture()

    normalized = (
        classify_and_normalize(
            raw
        )
    )

    _, steps = (
        split_jobs_and_steps(
            normalized
        )
    )

    steps = prepare_steps(
        steps
    )

    workload = steps.filter(
        pl.col(
            "is_workload_step"
        )
    )

    assert workload.height == 1

    assert (
        workload["gpu_util"][0]
        == 10
    )

    assert (
        workload[
            "gpu_mem_bytes"
        ][0]
        == 2278 * 1024 * 1024
    )


def test_consolidation():

    raw = make_fixture()

    normalized = (
        classify_and_normalize(
            raw
        )
    )

    jobs, steps = (
        split_jobs_and_steps(
            normalized
        )
    )

    steps = prepare_steps(
        steps
    )

    result = consolidate_jobs(
        jobs,
        steps,
    )

    assert result.height == 1

    row = result.row(
        0,
        named=True,
    )

    assert (
        row["job_id"]
        == "48327"
    )

    assert (
        row["jobid"]
        == "48327"
    )

    assert (
        row["jobidraw"]
        == "48327"
    )

    assert row["ncpus"] == 4
    assert row["nnodes"] == 1

    assert (
        row["nodelist"]
        == "gpu011"
    )

    assert (
        row["gpu_count"]
        == 1
    )

    assert (
        row["gpu_util_max"]
        == 10
    )

    assert (
        row["gpu_mem_max_bytes"]
        == 2278 * 1024 * 1024
    )

    assert (
        row["workload_step_count"]
        == 1
    )

    assert (
        row["step_count"]
        == 3
    )

