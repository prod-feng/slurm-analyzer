import re

import polars as pl


# ---------------------------------------------------------------------------
# Basic parsers
# ---------------------------------------------------------------------------

def _parse_int(value):
    if value is None:
        return None

    try:
        return int(float(str(value).strip()))
    except (TypeError, ValueError):
        return None


def _parse_float(value):
    if value is None:
        return None

    try:
        return float(str(value).strip())
    except (TypeError, ValueError):
        return None


# ---------------------------------------------------------------------------
# TRES parsing
# ---------------------------------------------------------------------------

def parse_gpu_count_from_tres(tres):
    """
    Extract GPU count from Slurm TRES strings.

    Examples:

        gres/gpu=1
        gres/gpu:a100=8
        billing=64,cpu=64,gres/gpu:a100=8,gres/gpu=8,...

    Returns float or None.
    """
    if tres is None:
        return None

    text = str(tres)

    total = 0.0
    found = False

    # Match:
    #   gres/gpu=8
    #   gres/gpu:a100=8
    #   gres/gpu:a100:40gb=8
    pattern = r"(?:^|,)gres/gpu(?:[:][^=,]+)*=([^,]+)"

    for match in re.finditer(pattern, text):
        value = _parse_float(match.group(1))
        if value is not None:
            total += value
            found = True

    if not found:
        return None

    return total


def parse_tres_usage(tres):
    """
    Parse selected values from TRESUsageInAve.

    Example:

        cpu=00:01:37,energy=0,fs/disk=...,mem=8555592K,...

    GPU utilization may appear in Slurm TRES usage as something such as:

        gres/gpuutil=666
        gres/gpuutil=666.0
        gres/gpumem=417515700224

    Returns:
        (gpu_util, gpu_mem_bytes)
    """
    if tres is None:
        return None, None

    text = str(tres)

    gpu_util = None
    gpu_mem = None

    # GPU utilization
    m = re.search(
        r"(?:^|,)gres/gpuutil=([^,]+)",
        text,
        flags=re.IGNORECASE,
    )

    if m:
        gpu_util = _parse_float(m.group(1))

    # GPU memory
    m = re.search(
        r"(?:^|,)gres/gpumem=([^,]+)",
        text,
        flags=re.IGNORECASE,
    )

    if m:
        raw = m.group(1).strip()

        # Slurm may report memory with suffixes.
        match = re.match(
            r"^([0-9]+(?:\.[0-9]+)?)([KMGTP]?)$",
            raw,
            flags=re.IGNORECASE,
        )

        if match:
            number = float(match.group(1))
            suffix = match.group(2).upper()

            multiplier = {
                "": 1,
                "K": 1024,
                "M": 1024 ** 2,
                "G": 1024 ** 3,
                "T": 1024 ** 4,
                "P": 1024 ** 5,
            }[suffix]

            gpu_mem = int(number * multiplier)
        else:
            gpu_mem = _parse_int(raw)

    return gpu_util, gpu_mem


# ---------------------------------------------------------------------------
# GPU normalization
# ---------------------------------------------------------------------------

def normalize_gpu_fields(df):
    """
    Populate:

        gpu_count
        gpu_util
        gpu_mem_bytes

    using Slurm alloctres and tresusageinave.

    Important:
    - GPU allocation comes from alloctres.
    - GPU utilization/memory come from TRESUsageInAve.
    - Job allocation rows normally have no TRES usage, so their
      gpu_util/gpu_mem_bytes remain null.
    """

    df = df.with_columns(
        pl.col("alloctres")
        .map_elements(
            parse_gpu_count_from_tres,
            return_dtype=pl.Float64,
        )
        .alias("gpu_count")
    )

    usage = df.select(
        pl.col("tresusageinave")
        .map_elements(
            lambda x: parse_tres_usage(x)[0],
            return_dtype=pl.Float64,
        )
        .alias("gpu_util"),

        pl.col("tresusageinave")
        .map_elements(
            lambda x: parse_tres_usage(x)[1],
            return_dtype=pl.Int64,
        )
        .alias("gpu_mem_bytes"),
    )

    df = df.with_columns(usage)

    return df


# ---------------------------------------------------------------------------
# Job/step identification
# ---------------------------------------------------------------------------

def classify_steps(df):
    """
    Classify Slurm records.

    Examples:

        49594
            step_type = job

        49594.batch
            step_type = batch

        49594.extern
            step_type = extern

        49594.0
            step_type = application
    """

    return df.with_columns(
        pl.when(pl.col("jobid").str.contains(r"^[0-9]+$"))
        .then(pl.lit("job"))
        .when(pl.col("jobid").str.ends_with(".batch"))
        .then(pl.lit("batch"))
        .when(pl.col("jobid").str.ends_with(".extern"))
        .then(pl.lit("extern"))
        .otherwise(pl.lit("application"))
        .alias("step_type")
    )


# ---------------------------------------------------------------------------
# Job ID normalization
# ---------------------------------------------------------------------------
def normalize_job_ids(df):
    """
    Normalize job IDs and create step_id.

    Examples:

        49594
            canonical_job_id = 49594
            step_id = 0

        49594.batch
            canonical_job_id = 49594
            step_id = batch

        49594.extern
            canonical_job_id = 49594
            step_id = extern

        49594.0
            canonical_job_id = 49594
            step_id = 0

        48910_3
            canonical_job_id = 48910_3
            step_id = 0

        48910_3.batch
            canonical_job_id = 48910_3
            step_id = batch
    """

    # ---------------------------------------------------------------
    # Create step_id
    # ---------------------------------------------------------------

    df = df.with_columns(
        pl.when(pl.col("jobid").str.contains(r"\."))
        .then(
            pl.col("jobid")
            .str.extract(r"\.([^.]*)$", 1)
        )
        .otherwise(
            pl.lit("0")
        )
        .alias("step_id")
    )

    # ---------------------------------------------------------------
    # Create canonical job ID
    # ---------------------------------------------------------------

    df = df.with_columns(
        pl.col("jobid")
        .str.replace(
            r"\.(batch|extern|[0-9]+)$",
            "",
        )
        .alias("canonical_job_id")
    )

    return df


def normalize_job_ids_old(df):
    """
    Create a canonical job ID.

    Normal jobs:

        49594 -> 49594

    Array jobs:

        raw jobid:
            48913

        normalized jobid:
            48910_3

    For steps:

        48913.batch
            canonical_job_id = 48910_3

    The existing normalized jobid is preserved.
    """

    # First normalize the raw Slurm jobid.

    def canonical_from_row(jobid, jobidraw):
        if jobid is None:
            return None

        jobid = str(jobid)
        raw = "" if jobidraw is None else str(jobidraw)

        # Already normalized array form, e.g. 48910_3
        if "_" in jobid and "." not in jobid:
            return jobid

        # Step records:
        # 48913.batch -> 48910_3.batch
        #
        # At this point the normalized jobid may already have been
        # generated upstream. Preserve it if it contains "_".
        if "_" in jobid:
            return jobid

        return jobid

    df = df.with_columns(
        pl.struct(["jobid", "jobidraw"])
        .map_elements(
            lambda x: canonical_from_row(
                x["jobid"],
                x["jobidraw"],
            ),
            return_dtype=pl.String,
        )
        .alias("_normalized_jobid")
    )

    # If jobid already contains the array notation, use it.
    #
    # Otherwise derive the parent job ID from the normalized jobid.
    df = df.with_columns(
        pl.when(
            pl.col("_normalized_jobid").str.contains(r"^[0-9]+_[0-9]+")
        )
        .then(
            pl.col("_normalized_jobid").str.extract(
                r"^([0-9]+_[0-9]+)",
                1,
            )
        )
        .otherwise(
            pl.col("_normalized_jobid")
            .str.extract(r"^([0-9]+)", 1)
        )
        .alias("canonical_job_id")
    )

    # For normal jobs, canonical_job_id is the job ID.
    #
    # For array jobs, this relies on the jobid normalization already
    # performed by the sacct ingestion layer.
    df = df.with_columns(
        pl.when(pl.col("step_type") == "job")
        .then(pl.col("_normalized_jobid"))
        .otherwise(pl.col("canonical_job_id"))
        .alias("canonical_job_id")
    )

    return df.drop("_normalized_jobid")


# ---------------------------------------------------------------------------
# Time normalization
# ---------------------------------------------------------------------------

def parse_elapsed_seconds(value):
    """
    Convert Slurm elapsed strings to seconds.

    Supported examples:

        12:34
        01:43:37
        10-00:00:05
        9-01:52:28
    """

    if value is None:
        return None

    text = str(value).strip()

    if not text or text.lower() == "unknown":
        return None

    try:
        days = 0

        if "-" in text:
            day_text, text = text.split("-", 1)
            days = int(day_text)

        parts = text.split(":")

        if len(parts) == 3:
            hours, minutes, seconds = parts
        elif len(parts) == 2:
            hours = 0
            minutes, seconds = parts
        elif len(parts) == 1:
            hours = 0
            minutes = 0
            seconds = parts[0]
        else:
            return None

        return (
            days * 86400
            + int(hours) * 3600
            + int(minutes) * 60
            + int(float(seconds))
        )

    except (TypeError, ValueError):
        return None


def normalize_times(df):
    """
    Normalize Slurm timestamp columns.
    """

    time_columns = [
        ("submit", "submit_time"),
        ("eligible", "eligible_time"),
        ("start", "start_time"),
        ("end", "end_time"),
    ]

    expressions = []

    for source, target in time_columns:
        if source in df.columns:
            expressions.append(
                pl.col(source)
                .str.to_datetime(
                    strict=False,
                    time_zone="UTC",
                )
                .alias(target)
            )

    if expressions:
        df = df.with_columns(expressions)

    if "elapsed" in df.columns:
        df = df.with_columns(
            pl.col("elapsed")
            .map_elements(
                parse_elapsed_seconds,
                return_dtype=pl.Int64,
            )
            .alias("elapsed_seconds")
        )

    if "timelimit" in df.columns:
        df = df.with_columns(
            pl.col("timelimit")
            .map_elements(
                parse_elapsed_seconds,
                return_dtype=pl.Int64,
            )
            .alias("time_limit_seconds")
        )

    return df


# ---------------------------------------------------------------------------
# Main normalization entry point
# ---------------------------------------------------------------------------

def classify_and_normalize(df):
    """
    Main normalization pipeline.
    """

    df = classify_steps(df)

    df = normalize_job_ids(df)

    df = normalize_times(df)

    df = normalize_gpu_fields(df)

    return df


# ---------------------------------------------------------------------------
# Split jobs and steps
# ---------------------------------------------------------------------------

def split_jobs_and_steps(df):
    """
    Allocation/job records:

        48327

    Step records:

        48327.batch
        48327.extern
        48327.99
    """

    jobs = df.filter(
        pl.col("step_type") == "job"
    )

    steps = df.filter(
        pl.col("step_type") != "job"
    )

    return jobs, steps


# ---------------------------------------------------------------------------
# Step flags
# ---------------------------------------------------------------------------

def add_step_flags(df):
    """
    Add semantic flags for step records.

    GPU activity is based ONLY on actual GPU usage:

        gpu_util > 0
        OR
        gpu_mem_bytes > 0

    Merely requesting/allocating a GPU does NOT constitute GPU activity.
    """

    df = df.with_columns(
        [
            (
                pl.col("step_id") == "batch"
            ).alias("is_batch"),

            (
                pl.col("step_id") == "extern"
            ).alias("is_extern"),

            (
                ~pl.col("step_id").is_in(["batch", "extern"])
            ).alias("is_application_step"),

            (
                (pl.col("gpu_util").fill_null(0.0) > 0.0)
                |
                (pl.col("gpu_mem_bytes").fill_null(0) > 0)
            ).alias("has_gpu_activity"),
        ]
    )

    # A workload step is:
    #
    # 1. A step with actual GPU activity, OR
    # 2. An application step that actually ran for > 0 seconds.
    #
    # batch/extern do not become workload steps merely because they
    # requested a GPU.
    df = df.with_columns(
        (
            pl.col("has_gpu_activity")
            |
            (
                pl.col("is_application_step")
                &
                (
                    pl.col("elapsed_seconds").fill_null(0) > 0
                )
            )
        ).alias("is_workload_step")
    )

    return df


# ---------------------------------------------------------------------------
# Prepare steps
# ---------------------------------------------------------------------------

def prepare_steps(steps):
    # step_id must exist before add_step_flags().
    if "step_id" not in steps.columns:
        steps = steps.with_columns(
            pl.when(pl.col("jobid").str.contains(r"\."))
            .then(
                pl.col("jobid")
                .str.extract(r"\.([^.]*)$", 1)
            )
            .otherwise(
                pl.lit("0")
            )
            .alias("step_id")
        )

    steps = add_step_flags(steps)

    columns = [
        "canonical_job_id",
        "jobid",
        "jobidraw",
        "step_id",
        "step_type",
        "cluster",
        "partition",
        "qos",
        "account",
        "user",
        "start_time",
        "end_time",
        "elapsed_seconds",
        "state",
        "nnodes",
        "ncpus",
        "reqcpus",
        "alloctres",
        "nodelist",
        "jobname",
        "tresusageinave",
        "gpu_count",
        "gpu_util",
        "gpu_mem_bytes",
        "is_workload_step",
        "has_gpu_activity",
    ]

    columns = [
        column
        for column in columns
        if column in steps.columns
    ]

    return steps.select(columns)


def prepare_steps_old(steps):
    steps = add_step_flags(steps)

    columns = [
        "canonical_job_id",
        "jobid",
        "jobidraw",
        "step_id",
        "step_type",
        "cluster",
        "partition",
        "qos",
        "account",
        "user",
        "start_time",
        "end_time",
        "elapsed_seconds",
        "state",
        "nnodes",
        "ncpus",
        "reqcpus",
        "alloctres",
        "nodelist",
        "jobname",
        "tresusageinave",
        "gpu_count",
        "gpu_util",
        "gpu_mem_bytes",
        "is_workload_step",
        "has_gpu_activity",
    ]

    # Only select columns that actually exist.
    columns = [
        column
        for column in columns
        if column in steps.columns
    ]

    return steps.select(columns)


# ---------------------------------------------------------------------------
# Consolidate jobs
# ---------------------------------------------------------------------------

def consolidate_jobs(jobs, steps):
    """
    Consolidate Slurm jobs.

    IMPORTANT:
    gpu_count is taken from the job allocation, not summed from steps.
    Slurm repeats GPU allocations across multiple steps.
    """

    if jobs.is_empty():
        return jobs

    # ------------------------------------------------------------
    # GPU allocation from the JOB row
    #
    # Example:
    #
    # 49594:
    #   alloctres =
    #   billing=64,cpu=64,gres/gpu:a100=8,...
    #
    # Therefore gpu_count = 8.
    # ------------------------------------------------------------

    def gpu_count_from_tres(value):
        if value is None:
            return None

        text = str(value)

        # Prefer generic gres/gpu=N
        import re

        match = re.search(r"gres/gpu=(\d+)", text)
        if match:
            return float(match.group(1))

        # Handle typed GPUs such as:
        # gres/gpu:a100=8
        matches = re.findall(r"gres/gpu:[^=,]+=(\d+)", text)

        if matches:
            return float(sum(int(x) for x in matches))

        return None

    # ------------------------------------------------------------
    # Derive GPU count from job-level alloctres
    # ------------------------------------------------------------

    jobs = jobs.with_columns(
        pl.col("alloctres")
        .map_elements(
            gpu_count_from_tres,
            return_dtype=pl.Float64,
        )
        .alias("_job_gpu_count")
    )

    # ------------------------------------------------------------
    # Step statistics
    # ------------------------------------------------------------

    step_stats = (
        steps
        .group_by("canonical_job_id")
        .agg([
            pl.col("gpu_util")
            .filter(pl.col("gpu_util").is_not_null())
            .min()
            .alias("gpu_util_min"),

            pl.col("gpu_util")
            .filter(pl.col("gpu_util").is_not_null())
            .max()
            .alias("gpu_util_max"),

            pl.col("gpu_mem_bytes")
            .filter(pl.col("gpu_mem_bytes").is_not_null())
            .max()
            .alias("gpu_mem_max_bytes"),

            pl.col("is_workload_step")
            .sum()
            .alias("workload_step_count"),

            pl.len()
            .alias("step_count"),
        ])
    )

    # ------------------------------------------------------------
    # Remove old derived GPU columns if they exist
    # ------------------------------------------------------------

    old_columns = [
        "gpu_count",
        "gpu_util_min",
        "gpu_util_max",
        "gpu_mem_max_bytes",
        "workload_step_count",
        "step_count",
    ]

    jobs = jobs.drop(
        [c for c in old_columns if c in jobs.columns]
    )

    # Rename our job-level GPU count
    jobs = jobs.rename({
        "_job_gpu_count": "gpu_count"
    })

    # ------------------------------------------------------------
    # Join step statistics
    # ------------------------------------------------------------

    result = jobs.join(
        step_stats,
        on="canonical_job_id",
        how="left",
    )

    return result

def consolidate_jobs_old(jobs, steps):
    """
    Produce one row per canonical job.

    GPU summary is calculated from step records.

    gpu_count:
        maximum allocated GPU count among the job's steps.

    gpu_util_min:
        minimum observed GPU utilization.

    gpu_util_max:
        maximum observed GPU utilization.

    gpu_mem_max_bytes:
        maximum observed GPU memory.

    workload_step_count:
        number of steps marked is_workload_step.

    step_count:
        total number of step records.

    Important:
        Missing GPU telemetry remains NULL rather than being converted
        to zero. This distinguishes:

            NULL = no GPU telemetry was reported

        from:

            0 = GPU telemetry was reported and usage was zero.
    """

    # Make sure steps have the flags.
    if "has_gpu_activity" not in steps.columns:
        steps = add_step_flags(steps)

    # ---------------------------------------------------------------
    # Job base table
    # ---------------------------------------------------------------

    job_columns = [
        "canonical_job_id",
        "jobid",
        "jobidraw",
        "cluster",
        "partition",
        "qos",
        "account",
        "user",
        "submit_time",
        "eligible_time",
        "start_time",
        "end_time",
        "elapsed_seconds",
        "state",
        "nnodes",
        "ncpus",
        "reqcpus",
        "alloctres",
        "nodelist",
        "jobname",
        "gpu_count",
    ]

    job_columns = [
        column
        for column in job_columns
        if column in jobs.columns
    ]

    consolidated = jobs.select(job_columns)

    # ---------------------------------------------------------------
    # Step aggregation
    # ---------------------------------------------------------------

    if steps.height == 0:
        return consolidated.with_columns(
            [
                pl.lit(None, dtype=pl.Float64).alias("gpu_util_min"),
                pl.lit(None, dtype=pl.Float64).alias("gpu_util_max"),
                pl.lit(None, dtype=pl.Int64).alias("gpu_mem_max_bytes"),
                pl.lit(0, dtype=pl.Int64).alias("workload_step_count"),
                pl.lit(0, dtype=pl.Int64).alias("step_count"),
            ]
        )

    step_summary = (
        steps
        .group_by("canonical_job_id")
        .agg(
            [
                pl.col("gpu_count")
                .max()
                .alias("step_gpu_count"),

                pl.col("gpu_util")
                .min()
                .alias("gpu_util_min"),

                pl.col("gpu_util")
                .max()
                .alias("gpu_util_max"),

                pl.col("gpu_mem_bytes")
                .max()
                .alias("gpu_mem_max_bytes"),

                pl.col("is_workload_step")
                .sum()
                .cast(pl.Int64)
                .alias("workload_step_count"),

                pl.len()
                .cast(pl.Int64)
                .alias("step_count"),
            ]
        )
    )

    # ---------------------------------------------------------------
    # Join
    # ---------------------------------------------------------------

    consolidated = consolidated.join(
        step_summary,
        on="canonical_job_id",
        how="left",
    )

    # Prefer step allocation if the job row itself has no GPU count.
    consolidated = consolidated.with_columns(
        pl.coalesce(
            [
                pl.col("gpu_count"),
                pl.col("step_gpu_count"),
            ]
        ).alias("gpu_count")
    )

    consolidated = consolidated.drop("step_gpu_count")

    # Jobs with no step rows should have step_count=0.
    consolidated = consolidated.with_columns(
        [
            pl.col("workload_step_count")
            .fill_null(0)
            .cast(pl.Int64),

            pl.col("step_count")
            .fill_null(0)
            .cast(pl.Int64),
        ]
    )

    return consolidated

